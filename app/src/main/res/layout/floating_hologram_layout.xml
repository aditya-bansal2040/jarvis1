<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floatingRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <!-- Smart Clipboard Pop-up Pill (Shown automatically when user copies text) -->
    <LinearLayout
        android:id="@+id/floatingClipboardPill"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_hud_card"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvClipboardSnippet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="160dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="⚡ Ask Jarvis"
            android:textColor="@color/cyan_glow"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnDismissClipboard"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Dismiss"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Draggable Floating Hologram Bubble -->
    <FrameLayout
        android:id="@+id/floatingBubbleContainer"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_floating_bubble">

        <com.jarvis.assistant.HologramView
            android:id="@+id/floatingHologramView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Expanded Quick Actions Menu (Shown when bubble is tapped) -->
    <LinearLayout
        android:id="@+id/floatingExpandedMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_hud_card"
        android:orientation="horizontal"
        android:padding="6dp"
        android:visibility="gone">

        <!-- Talk Once -->
        <ImageButton
            android:id="@+id/btnFloatingTalk"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_btn_hud"
            android:contentDescription="Talk"
            android:src="@android:drawable/ic_btn_speak_now"
            android:tint="@color/cyan_glow" />

        <!-- Continuous Hands-Free Duplex Loop Toggle -->
        <ImageButton
            android:id="@+id/btnFloatingLoop"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_btn_hud"
            android:contentDescription="Continuous Chat Loop"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="@color/text_secondary" />

        <!-- Force Stop -->
        <ImageButton
            android:id="@+id/btnFloatingStop"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_btn_stop"
            android:contentDescription="Force Stop"
            android:src="@android:drawable/ic_media_pause"
            android:tint="@color/red_stop" />

        <!-- Camera Vision -->
        <ImageButton
            android:id="@+id/btnFloatingCam"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_btn_hud"
            android:contentDescription="Camera Vision"
            android:src="@android:drawable/ic_menu_camera"
            android:tint="@color/cyan_glow" />

        <!-- Screen Vision -->
        <ImageButton
            android:id="@+id/btnFloatingScreen"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_btn_hud"
            android:contentDescription="Screen Vision"
            android:src="@android:drawable/ic_menu_view"
            android:tint="@color/cyan_glow" />

        <!-- Native Flashlight / Torch Toggle -->
        <ImageButton
            android:id="@+id/btnFloatingTorch"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_btn_hud"
            android:contentDescription="Flashlight"
            android:src="@android:drawable/ic_lock_power_off"
            android:tint="@color/gold_glow" />

        <!-- Ghost / Private Mode Toggle -->
        <ImageButton
            android:id="@+id/btnFloatingGhost"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_btn_hud"
            android:contentDescription="Ghost Mode"
            android:src="@android:drawable/ic_menu_view"
            android:tint="#b388ff" />

        <!-- 1-Tap Wipe Memory Flush -->
        <ImageButton
            android:id="@+id/btnFloatingWipe"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_btn_hud"
            android:contentDescription="Wipe Memory"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="@color/red_stop" />

        <!-- Close Overlay -->
        <ImageButton
            android:id="@+id/btnFloatingClose"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_btn_hud"
            android:contentDescription="Close"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/text_secondary" />
    </LinearLayout>

</LinearLayout>
