<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/red_stop_dim">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/red_stop_dim" />
            <stroke
                android:width="1.5dp"
                android:color="@color/red_stop" />
            <corners android:radius="10dp" />
            <padding
                android:bottom="12dp"
                android:left="20dp"
                android:right="20dp"
                android:top="12dp" />
        </shape>
    </item>
</ripple>
